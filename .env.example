# Copy sang .env và điền giá trị thật. KHÔNG commit .env.
# Prefix RAG_ cho các setting nội bộ (pydantic-settings).

# LLM provider: gemini (default dev) | hf_local
RAG_LLM_PROVIDER=gemini
RAG_GEMINI_MODEL=gemini-2.5-flash

# Bắt buộc khi dùng Gemini — lấy free tại https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Embedding tiếng Việt (HF Hub, load local)
RAG_EMBEDDING_MODEL=GreenNode/GreenNode-Embedding-Large-VN-Mixed-V1

# Chunking / retrieval
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
